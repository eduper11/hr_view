<?xml version="1.0" encoding="utf-8"?>
<!--
    El campo completo se pinta como Bitmap en nuestro proceso (HrFieldRenderer)
    y se muestra aqui. Asi podemos usar tipografia custom (IBM Plex Sans Condensed) y
    alinear baselines al pixel, cosas imposibles con TextViews en RemoteViews.
-->
<ImageView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iv_field"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY" />
